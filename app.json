{
  "expo": {
    "name": "kodeshRead",
    "slug": "kodeshread-",
    "owner": "shmuelks-team",
    "scheme": "kodeshread",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kodeshread.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F6F0E1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true,
      "libraryManifestUrl": "https://github.com/neriyafrank/kodeshRead/releases/latest/download/manifest.json",
      "eas": {
        "projectId": "a999e9f2-82e3-41af-a11b-d09d6e85c2eb"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "./plugins/withAndroidNoCompress",
        {
          "noCompress": [
            "db"
          ]
        }
      ],
      "expo-font",
      "expo-status-bar"
    ]
  }
}
