# EAS Build upload filter. When this file exists EAS uses it INSTEAD of .gitignore,
# so it repeats .gitignore except for the pre-built database.
# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Generated library database: unlike .gitignore, library.db and db-version.json ARE
# uploaded, so a full library built on your PC (`npm run db:full`) reaches EAS.
# The "preview" profile rebuilds the sample DB on the server anyway (scripts/eas-build-db.js).
assets/db/*.db.tmp
assets/db/*.db-journal

# Full Otzaria library is too large for git; only raw_library/sample/ is tracked
raw_library/full/**
!raw_library/full/.gitkeep
raw_links/full/**
!raw_links/full/.gitkeep
