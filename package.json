{
  "name": "kodeshread",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/assistant": "0.4.1",
    "@expo-google-fonts/david-libre": "0.4.1",
    "@expo-google-fonts/frank-ruhl-libre": "0.4.1",
    "@expo-google-fonts/heebo": "0.4.2",
    "@hebcal/core": "^6.16.1",
    "@hebcal/hdate": "^0.23.1",
    "@hebcal/learning": "^6.13.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.3.2",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "fflate": "0.8.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "db:sample": "node scripts/build-db.js --source=sample",
    "db:full": "node scripts/build-db.js --source=full",
    "db:release": "node scripts/build-db.js --source=full --release",
    "db:release:sample": "node scripts/build-db.js --source=sample --release",
    "db:ensure": "node scripts/build-db.js --source=sample --if-missing",
    "prestart": "npm run db:ensure --silent",
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "test": "node scripts/selftest.js",
    "e2e:search": "node scripts/e2e-search.js",
    "e2e:commentary": "node scripts/e2e-commentary.js",
    "e2e:library": "node scripts/e2e-library.js",
    "e2e:reader": "node scripts/e2e-reader.js",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "prebuild:android": "expo prebuild --platform android --clean",
    "apk": "expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "eas:preview": "npx eas-cli@latest build --platform android --profile preview"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
