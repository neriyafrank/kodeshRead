{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "22.13.0",
      "android": {
        "image": "latest"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "LIBRARY_SOURCE": "sample"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-full": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "LIBRARY_SOURCE": "full"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "env": {
        "LIBRARY_SOURCE": "full"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
